.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env
.env.*
!.env.example
*.key
*credential*
*secret*

# Large downloaded and derived data remain local.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Temporary download artifacts.
*.part
*.download
*.tmp

# Runtime logs may contain transient operational details.
logs/*.log
!logs/README.md

# Intermediate data and generated research artifacts remain local.
data/interim/*
!data/interim/.gitkeep
outputs/*
!outputs/README.md
!outputs/results/
!outputs/figures/
!outputs/tables/
!outputs/reports/
outputs/results/*
outputs/figures/*
outputs/tables/*
outputs/reports/*
!outputs/**/.gitkeep
.pytest_cache/
*.egg-info/
build/
dist/
